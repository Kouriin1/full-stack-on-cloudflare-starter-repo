/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "user-application",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/auth/*", "/trpc/*", "/click-socket"]
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "stage": {
      "d1_databases": [
    {
      "binding": "DB",
      "database_id": "7dfe7266-6e31-4ffd-a05c-5d798961f28e",
      "remote": true
    },
  ],
  "services": [{
    "binding": "BACKEND_SERVICE",
    "service": "data-service-stage",
    "remote": true
  }
]
    },
     "production": {
      "d1_databases": [
    {
      "binding": "DB",
      "database_id": "1b437151-a51a-4a2f-a209-268d83fc1ac5",
      "remote": true
    },
  ],
  "services": [{
    "binding": "BACKEND_SERVICE",
    "service": "data-service-production",
  }
]
    }
  }
}