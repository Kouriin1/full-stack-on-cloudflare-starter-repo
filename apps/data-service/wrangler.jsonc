/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "data-service",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-17",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"env": {
		"stage": {
		"ai": {
		"binding": "AI"

	},
	"r2_buckets": [{
		"binding": "BUCKET",
		"bucket_name": "smart-links-eval-stage",
		"remote": true

	}],

	"browser": {
		"binding": "VIRTUAL_BROWSER"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "7dfe7266-6e31-4ffd-a05c-5d798961f28e",
			"remote": true
		},
	],
	"kv_namespaces": [
		{

		"binding": "CACHE",
		"id": "0bf80eb6d1634f4e82e6ecdb7d372cc7",
		"remote": true
		
	}
],

"queues": {
	"consumers": [{
		"queue": "smart-links-data-queue-stage",
		
	}],
	"producers": [
	{
		"binding": "QUEUE",
		"queue": "smart-links-data-queue-stage",

	}]
	
},

"workflows": [

	{
		"binding": "DESTINATION_EVALUTATION_WORKFLOW",
		"name": "destination-evaluation-workflow",
		"class_name": "DestinationEvaluationWorkflow"


	}
],
"durable_objects": {
	"bindings": [{
		"name": "EVALUATION_SCHEDULER",
		"class_name": "EvaluationScheduler"
	},
	{
		"class_name": "LinkClickTracker",
		"name": "LINK_CLICK_TRACKER_OBJECT"
	}
]
},

"migrations": [
	{
		"tag": "v2",
		"new_sqlite_classes": ["EvaluationScheduler"]
	},
	{
		"tag": "v3",
		"new_sqlite_classes": ["LinkClickTracker"]
	}
]
		},

		"production": {
		"ai": {
		"binding": "AI"

	},
	"r2_buckets": [{
		"binding": "BUCKET",
		"bucket_name": "smart-links-eval-production",
		"remote": true

	}],

	"browser": {
		"binding": "VIRTUAL_BROWSER"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "1b437151-a51a-4a2f-a209-268d83fc1ac5",
			"remote": true
		},
	],
	"kv_namespaces": [
		{

		"binding": "CACHE",
		"id": "d5e82245b4b8445f92c25541f9d84dbf",
		
	}
],

"queues": {
	"consumers": [{
		"queue": "smart-links-data-queue-production",
		"dead_letter_queue": "smart-links-data-dead-letter-production"
	},
	{
		"queue": "smart-links-data-dead-letter-production",
		"retry_delay": 0
	}
],
	"producers": [
	{
		"binding": "QUEUE",
		"queue": "smart-links-data-queue-production",

	}]
	
},

"workflows": [

	{
		"binding": "DESTINATION_EVALUTATION_WORKFLOW",
		"name": "destination-evaluation-workflow-production",
		"class_name": "DestinationEvaluationWorkflow"


	}
],
"durable_objects": {
	"bindings": [{
		"name": "EVALUATION_SCHEDULER",
		"class_name": "EvaluationScheduler"
	},
	{
		"class_name": "LinkClickTracker",
		"name": "LINK_CLICK_TRACKER_OBJECT"
	}
]
},

"migrations": [
	{
		"tag": "v2",
		"new_sqlite_classes": ["EvaluationScheduler"]
	},
	{
		"tag": "v3",
		"new_sqlite_classes": ["LinkClickTracker"]
	}
]
		}
	}



}
